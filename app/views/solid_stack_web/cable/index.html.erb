<div class="sqw-page-header">
  <h1 class="sqw-page-title">Solid Cable</h1>
</div>

<div class="sqw-stats-grid">
  <div class="sqw-stat sqw-stat--cable">
    <span class="sqw-stat__label">Total Messages</span>
    <span class="sqw-stat__value"><%= @total_messages %></span>
  </div>
  <div class="sqw-stat sqw-stat--cable">
    <span class="sqw-stat__label">Channels</span>
    <span class="sqw-stat__value"><%= @channels.size %></span>
  </div>
</div>

<% if @channels.any? %>
  <table class="sqw-table">
    <thead>
      <tr>
        <th>Channel</th>
        <th>Messages</th>
        <th>Last Message</th>
      </tr>
    </thead>
    <tbody>
      <% @channels.each do |channel| %>
        <tr>
          <td class="sqw-monospace sqw-truncate" title="<%= channel[:channel] %>">
            <%= link_to channel[:channel], cable_channel_messages_path(channel[:channel_hash]), class: "sqw-link" %>
          </td>
          <td><%= channel[:message_count] %></td>
          <td class="sqw-muted"><%= channel[:last_message_at]&.strftime("%b %d %H:%M") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <div class="sqw-empty">
    <p>No cable messages.</p>
  </div>
<% end %>

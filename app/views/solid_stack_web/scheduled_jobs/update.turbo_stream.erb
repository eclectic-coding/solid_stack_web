<% if @run_now %>
  <%= turbo_stream.remove "execution_#{@execution.id}" %>
<% else %>
  <%= turbo_stream.replace "scheduled_at_#{@execution.id}" do %>
    <td id="scheduled_at_<%= @execution.id %>" class="sqw-muted">
      <%= @execution.scheduled_at.strftime("%b %d %H:%M") %>
    </td>
  <% end %>
<% end %>
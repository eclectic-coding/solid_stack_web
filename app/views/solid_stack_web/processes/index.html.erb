<%= turbo_frame_tag "sqw-processes", target: "_top",
      data: { controller: "refresh", refresh_interval_value: SolidStackWeb.default_refresh_interval } do %>
<div class="sqw-page-header">
  <h1 class="sqw-page-title">Processes</h1>
</div>

<% if @processes.any? %>
  <table class="sqw-table">
    <thead>
      <tr>
        <th>Kind</th>
        <th>Name</th>
        <th>PID</th>
        <th>Host</th>
        <th>Last Heartbeat</th>
      </tr>
    </thead>
    <tbody>
      <% @processes.each do |process| %>
        <tr>
          <td><span class="sqw-badge sqw-badge--<%= process.kind.downcase %>"><%= process.kind %></span></td>
          <td class="sqw-monospace"><%= process.name %></td>
          <td class="sqw-monospace"><%= process.pid %></td>
          <td class="sqw-muted"><%= process.hostname %></td>
          <td class="sqw-muted"><%= local_time(process.last_heartbeat_at) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <div class="sqw-empty">
    <p class="sqw-empty__title">No active processes</p>
    <p class="sqw-empty__hint">Start a Solid Queue worker to begin processing jobs.</p>
  </div>
<% end %>
<% end %>

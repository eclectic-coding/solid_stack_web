<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Solid Stack Dashboard</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= inline_styles %>
</head>
<body>
  <header class="sqw-header">
    <div class="sqw-header__inner">
      <%= link_to "Solid Stack", root_path, class: "sqw-header__logo" %>
      <nav class="sqw-nav">
        <%= link_to "Dashboard", root_path, class: "sqw-nav__link" %>
        <%= link_to "Jobs", jobs_path, class: "sqw-nav__link" %>
        <%= link_to "Failed", failed_jobs_path, class: "sqw-nav__link" %>
        <%= link_to "Queues", queues_path, class: "sqw-nav__link" %>
        <%= link_to "Processes", processes_path, class: "sqw-nav__link" %>
        <%= link_to "Cache", cache_path, class: "sqw-nav__link" %>
        <%= link_to "Cable", cable_path, class: "sqw-nav__link" %>
      </nav>
    </div>
  </header>
  <main class="sqw-main">
    <% flash.each do |type, message| %>
      <div class="sqw-flash sqw-flash--<%= type %>"><%= message %></div>
    <% end %>
    <%= yield %>
  </main>
</body>
</html>
